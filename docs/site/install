#!/bin/sh
# MusePi installer — redirects to npm
#
#   curl -fsSL https://muselinn.github.io/MusePi/install | sh
#
# MusePi is distributed as an npm package. To install:

cat <<'EOF'

  MusePi is installed via npm (requires Node.js 22+):

    npm install -g @musepi/coding-agent
    musepi --version

  Or run directly:

    npx @musepi/coding-agent

  See https://github.com/MuseLinn/MusePi for details.

EOF
