# Do not gitignore it; regenerate with `bun run gen:tool-views` after touching guest-client tool-render.
packages/natives/npm/
packages/coding-agent/src/utils/mupdf-wasm.wasm
/runs/
python/omp-rpc/src/omp_rpc.egg-info/
