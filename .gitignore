# Local, machine-specific boot perf baseline (see packages/coding-agent/scripts/bench-guard.ts)
packages/coding-agent/bench/boot-baseline.json

# The Pages site regenerates these on every deploy from docs/, so a committed
# copy would only ever be as fresh as the last commit that touched it.
