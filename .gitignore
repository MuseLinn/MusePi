web/robots.txt

# Bazel
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-pi
/bazel-oh-my-pi
/bazel-musepi-omp
/.bazelrc.user
# Build output — but the NSIS include is a SOURCE file that electron-builder
# resolves from this path (packages/desktop-app/package.json "include"), so it
# must stay tracked. The pattern is `release/*` plus a negation rather than
# `release/`: git never descends into an excluded directory, so a negation
# could not re-include a file inside one. (This file was silently dropped from
# the index during a history rebuild and broke the Windows release job.)
packages/desktop-app/release/*
!packages/desktop-app/release/ensure-shortcuts.nsh
!packages/desktop-app/release/installer-branding.nsh
# Dated local installer drops (manual packaging output kept beside release/).
packages/desktop-app/release-*/
packages/desktop-app/dist/

# WebView2 installer host: build output + the vendored NuGet SDK cache.
# `installer/ui/assets/brand-mark.png` is generated from build/icon.png by
# scripts/build-installer-host.mjs — tracked, because the UI must render the
# real brand mark even when opened directly for design review.
# `installer/ui/tokens.css` is a COPY of client-core's tokens, staged by the
# same script so the installer can never drift from the client's palette; it is
# ignored because the client file is the single source of truth.
packages/desktop-app/installer/.cache/
packages/desktop-app/installer/dist/
packages/desktop-app/installer/ui/tokens.css
# Generated by build-installer-host.mjs from package.json's version.
packages/desktop-app/installer/AutoVersion.cs

# macOS haptic helper (compiled from electron/haptic-helper.m by build:haptic)
packages/desktop-app/electron/haptic-helper
musepi-session-*.html

# Compiled daemon binary for packaged GUI (built on Windows; do not commit)
packages/desktop-app/vendor/
.v2c/
.zcode/

# Local scratch notes (reference-repo triage etc.) — never committed
/local/

# i18n split scratch (split(1) output from a one-off migration)
.tmp-i18n-rem-part-*

# Agent session state (memory, outputs) — never committed
.workbuddy/
.sisyphus/

# Dev desktop data isolation (dev-desktop.mjs): isolated daemon home, socket
# dir and Electron userData for `bun run desktop:dev` — never committed.
packages/desktop-app/.desktop-build/
# The renderer bundle actually emitted by the dev/build pipeline lands one
# level UP from the package (`packages/.desktop-build/`), so the rule above
# never matched it and the directory showed up as untracked on every run.
packages/.desktop-build/

# Brand glyph intermediates from scripts/regen-brand-icons.py (manually pasted
# into tray.cjs) — never committed
.tray-glyph-*.b64

# Root-level dev desktop scratch (list-procs.ps1, verify-scroll, ws-probe.mjs)
/.desktop-build/

# Local prototype state (machine-specific, not shared config)
.musepi/project.json

# Browser-panel screenshots land here; they are verification artifacts, not sources.
.openchamber/
