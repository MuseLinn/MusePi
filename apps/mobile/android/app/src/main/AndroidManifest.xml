<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Predictive back (Android 13+): Capacitor's App plugin routes back
         through getOnBackPressedDispatcher(), which registers the single
         framework OnBackInvokedCallback, so the flag and the web backButton
         listener stay one path — no double dispatch. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- musepi://connect?link=<collab link> — notification taps,
                     QR scans, or external links land here. singleTask keeps
                     the existing WebView instance (appUrlOpen warm-start). -->
                <data android:scheme="musepi" android:host="connect" />
            </intent-filter>

            <!-- Share sheet: a collab link pasted from a chat app. MainActivity
                 rewrites the ACTION_SEND intent into the musepi:// deep link
                 above before the bridge sees it, because @capacitor/app emits
                 appUrlOpen only for ACTION_VIEW (AppPlugin.handleOnNewIntent).
                 text/plain only — that is what chat apps share, and the
                 manifest has to declare every type the filter matches. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Launcher long-press shortcuts. Static shortcuts are declared on
                 the ACTIVITY through this meta-data key; there is no
                 android:shortcuts attribute. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR connect: the scanner (getUserMedia + jsQR, no plugin) needs the
         camera; the WebView requests runtime consent on first scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Haptics: the design spec's feedback table (§5.2 — connect, send, stop,
         error) runs through navigator.vibrate() in the WebView, which the
         platform silently drops without this. It is a normal permission: no
         runtime prompt, no user-visible consent. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
