{
	"type": "module",
	"name": "@musepi/gui",
	"version": "0.4.0",
	"private": true,
	"description": "MusePi desktop GUI — React SPA over the musepi daemon JSON-RPC (gui-architecture Phase 4)",
	"license": "MIT",
	"main": "./electron/main.cjs",
	"types": "./src/index.ts",
	"scripts": {
		"dev": "vite --port 5173 --strictPort",
		"dev:reload": "bun run build && touch .dev-reload-trigger",
		"tailwind": "bunx @tailwindcss/cli -i ./src/styles/tailwind.css -o ./src/styles/tailwind.out.css",
		"build:tailwind": "bun run tailwind",
		"build:bundle": "rm -rf dist && bun build ./index.html ./pet.html ./bubble.html ./pin.html --outdir=dist --minify --entry-naming=[hash].[ext] --chunk-naming=[hash].[ext] --asset-naming=[hash].[ext]",
		"build:pdf": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs dist/pdf.worker.min.mjs",
		"build:fix": "bun scripts/fix-dist-html.mjs",
		"build:haptic": "bun scripts/build-haptic.mjs",
		"build": "bun run build:tailwind && bun run build:bundle && bun run --parallel build:pdf build:fix build:haptic",
		"desktop": "bun run build && bun scripts/relaunch-gui.mjs && electron .",
		"desktop:dev": "bun scripts/dev-desktop.mjs",
		"desktop:run": "electron .",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"pack": "bun run build && electron-builder --mac dir && codesign --force --deep --sign - release/mac-arm64/MusePi.app",
		"pack:dir": "electron-builder --mac dir && codesign --force --deep --sign - release/mac-arm64/MusePi.app"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@tailwindcss/cli": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.5",
		"electron": "^43.2.0",
		"electron-builder": "^26.15.3",
		"tailwindcss": "^4.3.3",
		"vite": "^8.2.1",
		"@musepi/collab-web": "workspace:*",
		"@musepi/pi-natives": "workspace:*",
		"@musepi/pi-wire": "workspace:*",
		"@musepi/sdk": "workspace:*",
		"@xterm/xterm": "^6.0.0",
		"cuelume": "^0.2.1",
		"lucide": "^1.29.0",
		"lucide-react": "^1.24.0",
		"morphicons": "^1.4.2",
		"html-to-image": "^1.11.13",
		"pdfjs-dist": "^6.2.108",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"dist",
		"src"
	],
	"update": {
		"manifestUrl": ""
	},
	"build": {
		"appId": "com.musepi.gui",
		"productName": "MusePi",
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"dist/**/*",
			"electron/**/*",
			"vendor/**/*",
			"node_modules/@musepi/pi-natives/**/*",
			"!node_modules/@musepi/pi-natives/bench/**"
		],
  "asarUnpack": [
    "**/*.node",
    "electron/haptic-helper",
    "vendor/daemon/**"
  ],
		"npmRebuild": false,
		"mac": {
			"target": [
				"dir"
			],
			"category": "public.app-category.developer-tools",
			"identity": null
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "build/icon.png"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"artifactName": "${productName}-${version}-setup.${ext}"
		}
	}
}
