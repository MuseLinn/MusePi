{
	"name": "@musepi/collab-proto",
	"version": "0.4.8",
	"description": "Collab live-session wire transport: AES-GCM sealing, link format, envelope, relay WebSocket client. Pure transport \u2014 no agent/session dependencies, browser-safe (zero Buffer).",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	},
	"dependencies": {
		"@musepi/pi-wire": "workspace:*"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"test": "bun test"
	}
}