{
	"name": "musepi-stt",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"musepi": {
		"label": "语音输入（STT）",
		"description": "本地 Whisper、SenseVoice 与 Parakeet 语音转写，首次使用时下载模型。",
		"icon": "🎙️",
		"extensions": ["./index.ts"],
		"components": [
			{ "id": "whisper", "entry": "./whisper.ts", "description": "Whisper 系列本地转写引擎。" },
			{ "id": "sensevoice", "entry": "./sensevoice.ts", "description": "SenseVoice 本地转写引擎。" },
			{ "id": "parakeet", "entry": "./parakeet.ts", "description": "Parakeet 本地转写引擎。" }
		],
		"config": [
			{ "key": "stt.modelName", "type": "select", "options": ["fast", "balanced", "turbo", "parakeet", "sensevoice"], "default": "balanced", "restart": "none", "label": "转写模型", "description": "选择默认的本地语音转写模型。" },
			{ "key": "stt.language", "type": "string", "default": "", "restart": "none", "label": "识别语言", "description": "留空时自动检测语言。" },
			{ "key": "stt.vadEndMs", "type": "number", "default": 700, "restart": "none", "label": "静音结束时长", "description": "连续静音达到该毫秒数后结束录音。" },
			{ "key": "stt.submitTrigger", "type": "select", "options": ["never", "release", "release-complete", "say-submit"], "default": "never", "restart": "none", "label": "自动提交方式", "description": "选择听写完成后是否以及如何提交。" }
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
