{
	"name": "musepi-tts",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"musepi": {
		"label": "语音输出（TTS）",
		"description": "Kokoro 与 MeloTTS 中文流式语音朗读，首次使用时下载模型。",
		"icon": "🔊",
		"extensions": ["./index.ts"],
		"components": [
			{ "id": "kokoro", "entry": "./kokoro.ts", "description": "Kokoro 82M 本地语音合成引擎。" },
			{ "id": "melotts-zh", "entry": "./melotts-zh.ts", "description": "MeloTTS 中文本地语音合成引擎。" }
		],
		"config": [
			{ "key": "tts.localModel", "type": "select", "options": ["kokoro", "melotts-zh"], "default": "kokoro", "restart": "none", "label": "合成模型", "description": "选择默认的本地语音合成模型。" },
			{ "key": "tts.localVoice", "type": "select", "options": ["af_heart", "af_bella", "af_nicole", "af_aoede", "af_kore", "af_sarah", "am_michael", "am_fenrir", "am_puck", "bf_emma", "bm_george", "bm_fable", "default"], "default": "af_heart", "restart": "none", "label": "音色", "description": "选择合成语音的默认音色。" },
			{ "key": "tts.rate", "type": "number", "default": 1, "min": 0.5, "max": 2, "step": 0.1, "restart": "none", "label": "语速", "description": "调整朗读速度，范围为 0.5 至 2 倍。" },
			{ "key": "tts.inputMode", "type": "select", "options": ["raw", "sanitize", "summarize"], "default": "sanitize", "restart": "none", "label": "朗读内容处理", "description": "选择朗读前保留、清理或总结文本。" },
			{ "key": "tts.autoRead", "type": "boolean", "default": false, "restart": "none", "label": "自动朗读", "description": "助手回复完成后自动开始朗读。" }
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
