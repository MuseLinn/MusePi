{
	"name": "musepi-computer",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"musepi": {
		"label": "电脑操作",
		"description": "通过截图、输入与无障碍树操作宿主机桌面。",
		"icon": "🖱️",
		"extensions": ["./index.ts"],
		"components": [{ "id": "computer", "entry": "./computer-tool.ts", "description": "电脑操作工具。" }],
		"config": [
			{ "key": "computer.display", "type": "string", "default": "all", "restart": "none", "label": "显示器", "description": "选择截图与操作使用的显示器。" },
			{ "key": "computer.maxWidth", "type": "number", "default": 3840, "restart": "none", "label": "最大截图宽度", "description": "限制电脑操作截图的最大宽度。" }
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
