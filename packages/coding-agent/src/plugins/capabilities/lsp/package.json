{
	"name": "musepi-lsp",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Definitions, references, diagnostics and rename through language servers.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Language Server (LSP)",
		"description": "Definitions, references, diagnostics and rename through language servers.",
		"icon": "🔎",
		"extensions": [
			"./index.ts"
		],
		"config": [
			{
				"key": "lsp.lazy",
				"type": "boolean",
				"default": true,
				"restart": "session",
				"label": "按需启动",
				"description": "首次调用语言功能时再启动语言服务器。"
			},
			{
				"key": "lsp.shared",
				"type": "boolean",
				"default": true,
				"restart": "daemon",
				"label": "共享实例",
				"description": "在会话之间复用兼容的语言服务器实例。"
			}
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
