{
	"name": "musepi-android-emulator",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "View and operate Android emulators, install APKs, inspect UI trees and read logcat.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/musepi-type": "workspace:*",
		"@musepi/pi-agent-core": "workspace:*",
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-wire": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"icon": "▣",
		"label": "Android Emulator",
		"description": "View and operate Android emulators, install APKs, inspect UI trees and read logcat.",
		"extensions": [
			"./index.ts"
		]
	}
}
