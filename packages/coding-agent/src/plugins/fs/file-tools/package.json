{
	"name": "musepi-file-tools",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Workspace read, write and search tools plus the background content index.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "File Tools and Index",
		"description": "Workspace read, write and search tools plus the background content index.",
		"icon": "📁",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "read",
				"entry": "./read.ts",
				"description": "文件读取工具族。"
			},
			{
				"id": "write",
				"entry": "./write.ts",
				"description": "文件写入与编辑工具族。"
			},
			{
				"id": "search",
				"entry": "./search.ts",
				"description": "文件搜索工具族。"
			},
			{
				"id": "index",
				"entry": "./index-backend.ts",
				"description": "后台内容索引。"
			}
		],
		"host": {
			"readonly": true
		}
	}
}
