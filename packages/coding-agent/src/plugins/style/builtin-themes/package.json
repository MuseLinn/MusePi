{
	"name": "musepi-builtin-themes",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "The dark, light and default terminal themes that ship with the CLI.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Built-in Themes",
		"description": "The dark, light and default terminal themes that ship with the CLI.",
		"icon": "🎨",
		"extensions": [
			"./index.ts"
		],
		"host": {
			"readonly": true,
			"raw": {
				"source": "builtin-themes"
			}
		}
	}
}
