{
	"name": "musepi-prompt-suggestion",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Offer a predicted next message in the empty input box; Tab or → accepts it.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"icon": "↩",
		"label": "Input Suggestions",
		"description": "Offer a predicted next message in the empty input box; Tab or → accepts it.",
		"extensions": [
			"./index.ts"
		]
	}
}
