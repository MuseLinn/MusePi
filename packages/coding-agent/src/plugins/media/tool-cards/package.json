{
	"name": "musepi-tool-cards",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "The first-party card renderers for built-in tools in the GUI.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Tool Card Renderers",
		"description": "The first-party card renderers for built-in tools in the GUI.",
		"icon": "🧩",
		"extensions": [
			"./index.ts"
		],
		"host": {
			"readonly": true,
			"raw": {
				"source": "tool-cards"
			}
		}
	}
}
