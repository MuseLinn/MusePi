{
	"name": "musepi-board",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Read and write the desktop board's card wall: list boards, edit cards, and query the widget schema.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/musepi-type": "workspace:*",
		"@musepi/pi-agent-core": "workspace:*",
		"@musepi/pi-ai": "workspace:*",
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"icon": "▦",
		"label": "Board",
		"description": "Read and write the desktop board's card wall: list boards, edit cards, and query the widget schema.",
		"extensions": [
			"./index.ts"
		]
	}
}
