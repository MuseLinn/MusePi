{
	"name": "musepi-preset-creator",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "The creator preset's persona prompt section.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "MusePi Creator Persona",
		"description": "The creator preset's persona prompt section.",
		"icon": "🛠️",
		"presetOnly": true,
		"extensions": [
			"./index.ts"
		]
	}
}
