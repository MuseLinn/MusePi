{
	"name": "musepi-memory-tools",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "Long-term memory tools (retain, recall, reflect, edit) and the auto-learn capture tool.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Memory Tools",
		"description": "Long-term memory tools (retain, recall, reflect, edit) and the auto-learn capture tool.",
		"icon": "🧠",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "retain",
				"entry": "./retain.ts",
				"description": "写入长期记忆。"
			},
			{
				"id": "recall",
				"entry": "./recall.ts",
				"description": "从长期记忆检索。"
			},
			{
				"id": "reflect",
				"entry": "./reflect.ts",
				"description": "基于长期记忆作答。"
			},
			{
				"id": "edit",
				"entry": "./edit.ts",
				"description": "编辑 Mnemopi 记忆库。"
			},
			{
				"id": "learn",
				"entry": "./learn.ts",
				"description": "把可复用的经验写入记忆。"
			}
		],
		"host": {
			"readonly": true
		}
	}
}
