{
	"name": "musepi-memory-hindsight",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "Host-half adapter that registers the Hindsight remote memory backend as a provider.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Hindsight Memory Backend",
		"description": "Host-half adapter that registers the Hindsight remote memory backend as a provider.",
		"icon": "◈",
		"scope": "host",
		"extensions": [
			"./index.ts"
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
