{
	"name": "musepi-terminal",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "bun-pty and node-pty backends with automatic fallback, for the TUI and the GUI terminal.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Terminal",
		"description": "bun-pty and node-pty backends with automatic fallback, for the TUI and the GUI terminal.",
		"icon": "⌨️",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "bun-pty",
				"entry": "./bun-pty.ts",
				"description": "Bun PTY 终端后端。"
			},
			{
				"id": "node-pty",
				"entry": "./node-pty.ts",
				"description": "Node PTY 终端后端。"
			}
		],
		"host": {
			"readonly": true,
			"configStorage": "settings"
		}
	}
}
