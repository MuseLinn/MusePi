{
	"name": "musepi-subagent-opencode",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Run the native OpenCode CLI through the existing task tool without relaxing permissions.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"icon": "O",
		"label": "OpenCode Subagent",
		"description": "Run the native OpenCode CLI through the existing task tool without relaxing permissions.",
		"experimental": true,
		"extensions": [
			"./index.ts"
		],
		"config": [
			{
				"key": "executable",
				"type": "path",
				"label": "OpenCode 可执行文件",
				"description": "留空时从 PATH 查找 opencode。",
				"default": ""
			},
			{
				"key": "model",
				"type": "string",
				"label": "原生模型",
				"description": "可选的 provider/model 标识。",
				"default": ""
			},
			{
				"key": "env",
				"type": "string",
				"label": "环境变量 JSON",
				"description": "可选的字符串键值 JSON 对象。",
				"default": ""
			},
			{
				"key": "disposeGraceMs",
				"type": "number",
				"label": "退出宽限（毫秒）",
				"default": 3000
			}
		]
	}
}
