{
	"name": "musepi-computer",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Operate the host desktop through screenshots, input and the accessibility tree.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Computer Use",
		"description": "Operate the host desktop through screenshots, input and the accessibility tree.",
		"icon": "🖱️",
		"extensions": [
			"./index.ts"
		],
		"config": [
			{
				"key": "computer.display",
				"type": "string",
				"default": "all",
				"restart": "none",
				"label": "显示器",
				"description": "选择截图与操作使用的显示器。"
			},
			{
				"key": "computer.maxWidth",
				"type": "number",
				"default": 3840,
				"restart": "none",
				"label": "最大截图宽度",
				"description": "限制电脑操作截图的最大宽度。"
			}
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
