{
	"name": "musepi-tts",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "Streaming Chinese speech via Kokoro and MeloTTS; models download on first use.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Voice Output (TTS)",
		"description": "Streaming Chinese speech via Kokoro and MeloTTS; models download on first use.",
		"icon": "🔊",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "kokoro",
				"entry": "./kokoro.ts",
				"description": "Kokoro 82M 本地语音合成引擎。"
			},
			{
				"id": "melotts-zh",
				"entry": "./melotts-zh.ts",
				"description": "MeloTTS 中文本地语音合成引擎。"
			}
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
