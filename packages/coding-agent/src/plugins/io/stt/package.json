{
	"name": "musepi-stt",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"description": "Local Whisper, SenseVoice and Parakeet transcription; models download on first use.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Voice Input (STT)",
		"description": "Local Whisper, SenseVoice and Parakeet transcription; models download on first use.",
		"icon": "🎙️",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "whisper",
				"entry": "./whisper.ts",
				"description": "Whisper 系列本地转写引擎。"
			},
			{
				"id": "sensevoice",
				"entry": "./sensevoice.ts",
				"description": "SenseVoice 本地转写引擎。"
			},
			{
				"id": "parakeet",
				"entry": "./parakeet.ts",
				"description": "Parakeet 本地转写引擎。"
			}
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
