{
	"name": "musepi-tool-connector-catalog",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Read-only MCP connector catalog.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Connector Catalog",
		"description": "Read-only MCP connector catalog.",
		"icon": "🔌",
		"extensions": [
			"./index.ts"
		],
		"host": {
			"readonly": true
		}
	}
}
