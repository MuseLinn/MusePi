{
	"name": "musepi-browser",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Scripted Chromium automation and the in-app browser bridge.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json",
		"./*": "./*.ts"
	},
	"files": [
		"lib",
		"*.ts",
		"*.tsx",
		"*.md",
		"*.json",
		"locale",
		"skills"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Browser",
		"description": "Scripted Chromium automation and the in-app browser bridge.",
		"icon": "🌐",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "launch",
				"entry": "./launch.ts",
				"description": "启动托管浏览器。"
			},
			{
				"id": "attach",
				"entry": "./attach.ts",
				"description": "连接已有浏览器。"
			},
			{
				"id": "gui",
				"entry": "./gui.ts",
				"description": "应用内浏览器界面。"
			}
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
