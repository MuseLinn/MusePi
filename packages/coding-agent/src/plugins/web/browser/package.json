{
	"name": "musepi-browser",
	"version": "0.7.7",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Scripted Chromium automation and the in-app browser bridge.",
	"main": "./lib/index.js",
	"types": "./lib/types/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/types/index.d.ts",
			"default": "./lib/index.js"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"peerDependencies": {
		"@musepi/pi-coding-agent": "workspace:*",
		"@musepi/pi-utils": "workspace:*"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"musepi": {
		"label": "Browser",
		"description": "Scripted Chromium automation and the in-app browser bridge.",
		"icon": "🌐",
		"extensions": [
			"./index.ts"
		],
		"components": [
			{
				"id": "launch",
				"entry": "./launch.ts",
				"description": "启动托管浏览器。"
			},
			{
				"id": "attach",
				"entry": "./attach.ts",
				"description": "连接已有浏览器。"
			},
			{
				"id": "gui",
				"entry": "./gui.ts",
				"description": "应用内浏览器界面。"
			}
		],
		"config": [
			{
				"key": "browser.headless",
				"type": "boolean",
				"default": true,
				"restart": "none",
				"label": "无头兜底",
				"description": "无桌面内置浏览器时以无头 Chromium 兜底。"
			},
			{
				"key": "browser.cdpUrl",
				"type": "string",
				"default": "",
				"restart": "none",
				"label": "CDP 地址",
				"description": "连接已有 Chromium 调试端点；留空时使用默认启动方式。"
			}
		],
		"host": {
			"configStorage": "settings"
		}
	}
}
