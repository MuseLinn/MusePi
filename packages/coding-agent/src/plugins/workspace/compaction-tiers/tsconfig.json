{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"allowArbitraryExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"bun",
			"assets"
		],
		"typeRoots": [
			"D:\\Projects\\Agents\\MusePi\\types",
			"D:\\Projects\\Agents\\MusePi\\node_modules\\@types"
		],
		"rootDir": ".",
		"outDir": "lib",
		"tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"noEmit": false
	},
	"references": [
		{
			"path": "../../../../tsconfig.plugin-host.json"
		}
	],
	"include": [
		"*.ts",
		"*.tsx"
	],
	"exclude": [
		"lib",
		"node_modules"
	]
}
