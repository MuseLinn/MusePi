{
	"$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/theme-schema.json",
	"name": "musepi-light",
	"vars": {
		"page": "#f6f4f1",
		"band1": "#efedea",
		"band2": "#e7e5e2",
		"band3": "#dcd9d5",
		"text": "#1e1a15",
		"muted": "#6b6660",
		"dim": "#9a948e",
		"accent": "#0c8f66",
		"accentStrong": "#0a7d59",
		"accentDim": "#2aa87c",
		"ring": "#1583a8",
		"ok": "#228a5e",
		"warn": "#a06a17",
		"err": "#c14a52",
		"violet": "#7e57c2"
	},
	"colors": {
		"accent": "$accent",
		"border": "$band3",
		"borderAccent": "$ring",
		"borderMuted": "$band1",
		"success": "$ok",
		"error": "$err",
		"warning": "$warn",
		"muted": "$muted",
		"dim": "$dim",
		"text": "",
		"thinkingText": "$muted",
		"selectedBg": "$band2",
		"userMessageBg": "$band1",
		"userMessageText": "",
		"customMessageBg": "$band2",
		"customMessageText": "",
		"customMessageLabel": "$violet",
		"toolPendingBg": "$band1",
		"toolSuccessBg": "$band1",
		"toolErrorBg": "$band1",
		"toolTitle": "",
		"toolOutput": "$muted",
		"mdHeading": "$accent",
		"mdLink": "$ring",
		"mdLinkUrl": "$dim",
		"mdCode": "$accentDim",
		"mdCodeBlock": "$text",
		"mdCodeBlockBorder": "$band3",
		"mdQuote": "$muted",
		"mdQuoteBorder": "$band2",
		"mdHr": "$band2",
		"mdListBullet": "$accent",
		"toolDiffAdded": "$ok",
		"toolDiffRemoved": "$err",
		"toolDiffContext": "$muted",
		"syntaxComment": "$dim",
		"syntaxKeyword": "$accent",
		"syntaxFunction": "$accentStrong",
		"syntaxVariable": "$text",
		"syntaxString": "$accentDim",
		"syntaxNumber": "$warn",
		"syntaxType": "$ring",
		"syntaxOperator": "$muted",
		"syntaxPunctuation": "$muted",
		"thinkingOff": "$band3",
		"thinkingMinimal": "$dim",
		"thinkingLow": "$accentDim",
		"thinkingMedium": "$accent",
		"thinkingHigh": "$violet",
		"thinkingXhigh": "$text",
		"bashMode": "$ring",
		"statusLineBg": "$band1",
		"statusLineSep": "$band3",
		"statusLineModel": "$accent",
		"statusLinePath": "$text",
		"statusLineGitClean": "$ok",
		"statusLineGitDirty": "$warn",
		"statusLineContext": "$muted",
		"statusLineSpend": "$accentDim",
		"statusLineStaged": "$ok",
		"statusLineDirty": "$warn",
		"statusLineUntracked": "$muted",
		"statusLineOutput": "$text",
		"statusLineCost": "$accentDim",
		"statusLineSubagents": "$accent",
		"pythonMode": "$warn"
	},
	"export": {
		"pageBg": "$page",
		"cardBg": "$band1",
		"infoBg": "$band2"
	}
}
