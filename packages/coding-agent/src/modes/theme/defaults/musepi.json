{
	"$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/theme-schema.json",
	"name": "musepi",
	"vars": {
		"page": "#0f0b09",
		"band1": "#17130f",
		"band2": "#211c17",
		"band3": "#2a2520",
		"text": "#ece7e3",
		"muted": "#a9a39e",
		"dim": "#76706c",
		"accent": "#34d399",
		"accentStrong": "#3add9e",
		"accentDim": "#8fd8b8",
		"ring": "#5ad8e5",
		"ok": "#5ee6a8",
		"warn": "#ffc24b",
		"err": "#ff5f6d",
		"violet": "#b281d6"
	},
	"colors": {
		"accent": "$accent",
		"border": "$band3",
		"borderAccent": "$ring",
		"borderMuted": "$band1",
		"success": "$ok",
		"error": "$err",
		"warning": "$warn",
		"muted": "$muted",
		"dim": "$dim",
		"text": "",
		"thinkingText": "$muted",
		"selectedBg": "$band2",
		"userMessageBg": "$band1",
		"userMessageText": "",
		"customMessageBg": "$band2",
		"customMessageText": "",
		"customMessageLabel": "$violet",
		"toolPendingBg": "$band1",
		"toolSuccessBg": "$band1",
		"toolErrorBg": "$band1",
		"toolTitle": "",
		"toolOutput": "$muted",
		"mdHeading": "$accent",
		"mdLink": "$ring",
		"mdLinkUrl": "$dim",
		"mdCode": "$accentDim",
		"mdCodeBlock": "$text",
		"mdCodeBlockBorder": "$band3",
		"mdQuote": "$muted",
		"mdQuoteBorder": "$band2",
		"mdHr": "$band2",
		"mdListBullet": "$accent",
		"toolDiffAdded": "$ok",
		"toolDiffRemoved": "$err",
		"toolDiffContext": "$muted",
		"syntaxComment": "$dim",
		"syntaxKeyword": "$accent",
		"syntaxFunction": "$accentStrong",
		"syntaxVariable": "$text",
		"syntaxString": "$accentDim",
		"syntaxNumber": "$warn",
		"syntaxType": "$ring",
		"syntaxOperator": "$muted",
		"syntaxPunctuation": "$muted",
		"thinkingOff": "$band3",
		"thinkingMinimal": "$dim",
		"thinkingLow": "$accentDim",
		"thinkingMedium": "$accent",
		"thinkingHigh": "$violet",
		"thinkingXhigh": "$text",
		"bashMode": "$ring",
		"statusLineBg": "$band1",
		"statusLineSep": "$band3",
		"statusLineModel": "$accent",
		"statusLinePath": "$text",
		"statusLineGitClean": "$ok",
		"statusLineGitDirty": "$warn",
		"statusLineContext": "$muted",
		"statusLineSpend": "$accentDim",
		"statusLineStaged": "$ok",
		"statusLineDirty": "$warn",
		"statusLineUntracked": "$muted",
		"statusLineOutput": "$text",
		"statusLineCost": "$accentDim",
		"statusLineSubagents": "$accent",
		"pythonMode": "$warn"
	},
	"export": {
		"pageBg": "$page",
		"cardBg": "$band1",
		"infoBg": "$band2"
	}
}
