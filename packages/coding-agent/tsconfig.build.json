{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@musepi/core": ["../musepi/core/dist/index.d.ts"],
			"@musepi/core/*": ["../musepi/core/dist/*/index.d.ts"],
			"@musepi/core/i18n": ["../musepi/core/dist/i18n/index.d.ts"],
			"@musepi/core/advisor": ["../musepi/core/dist/advisor/index.d.ts"],
			"@musepi/pi-agent-core": ["../agent/dist/index.d.ts"],
			"@musepi/pi-agent-core/*": ["../agent/dist/*.d.ts"],
			"@musepi/pi-ai": ["../ai/dist/index.d.ts"],
			"@musepi/pi-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@musepi/pi-tui": ["../tui/dist/index.d.ts"],
			"@musepi/pi-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"],
			"@musepi/transcript": ["../musepi/transcript/dist/index.d.ts"],
			"@musepi/transcript/*": ["../musepi/transcript/dist/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
