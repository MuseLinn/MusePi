{
	"type": "module",
	"private": true,
	"name": "@musepi/pi-metaharness",
	"version": "0.0.1",
	"description": "Unified benchmark runners plus Harbor run storage, REST/SSE APIs, and a live web dashboard",
	"homepage": "https://github.com/MuseLinn/MusePi",
	"author": "MuseLinn",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MuseLinn/MusePi.git",
		"directory": "packages/metaharness"
	},
	"bin": {
		"metaharness": "src/server.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p adapters/edit/tsconfig.json --noEmit && tsgo -p scripts/tsconfig.json --noEmit",
		"lint": "biome lint .",
		"serve": "bun run src/server.ts",
		"dev": "bun --hot src/server.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@musepi/hashline": "workspace:*",
		"@musepi/pi-agent-core": "workspace:*",
		"@musepi/pi-ai": "workspace:*",
		"@musepi/pi-catalog": "workspace:*",
		"@musepi/pi-utils": "workspace:*",
		"@musepi/typescript-edit-benchmark": "workspace:*",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"diff": "^9.0.0",
		"@musepi/pi-natives": "workspace:*",
		"motion": "^12.15.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.3.0",
		"@musepi/pi-coding-agent": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"react-refresh": "^0.18.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
