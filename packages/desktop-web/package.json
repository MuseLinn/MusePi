{
	"type": "module",
	"name": "@musepi/desktop-web",
	"version": "0.4.14",
	"private": true,
	"description": "Browser guest client and local relay tools for omp collab live sessions",
	"homepage": "https://github.com/MuseLinn/MusePi",
	"author": "MuseLinn",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MuseLinn/MusePi.git",
		"directory": "packages/desktop-web"
	},
	"bugs": {
		"url": "https://github.com/MuseLinn/MusePi/issues"
	},
	"keywords": [
		"collab",
		"relay",
		"websocket",
		"react",
		"agent"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./src/*": {
			"types": "./src/*",
			"import": "./src/*"
		},
		"./widgets/registry": {
			"types": "./src/widgets/registry.ts",
			"default": "./src/widgets/registry.ts"
		},
		"./widgets/count-up": {
			"types": "./src/widgets/count-up.ts",
			"default": "./src/widgets/count-up.ts"
		}
	},
	"scripts": {
		"dev": "bun ./index.html",
		"mock-host": "bun scripts/mock-host.ts",
		"relay": "bun scripts/local-relay.ts",
		"build": "rm -rf dist && bun build ./index.html ./mobile.html --outdir=dist --minify --entry-naming=[name]-[hash].[ext] --chunk-naming=[hash].[ext] --asset-naming=[hash].[ext] && mv dist/index-*.html dist/index.html && mv dist/mobile-*.html dist/mobile.html && cp -R public/. dist/ && cp public/sw.js dist/sw.js",
		"gen:tool-views": "bun scripts/build-tool-views.ts",
		"prepack": "bun run build",
		"test": "bun test --parallel",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@capacitor/app": "^8.0.0",
		"@capacitor/keyboard": "^8.0.0",
		"@capacitor/local-notifications": "^8.1.1",
		"@capacitor/status-bar": "^8.0.0",
		"@capawesome/capacitor-badge": "^8.0.2",
		"@musepi/collab-proto": "workspace:*",
		"@musepi/pi-utils": "catalog:",
		"@musepi/pi-wire": "workspace:*",
		"beautiful-mermaid": "^1.1.3",
		"cuelume": "^0.2.1",
		"jsqr": "^1.4.0",
		"katex": "^0.17.0",
		"lucide": "^1.29.0",
		"lucide-react": "^1.24.0",
		"mermaid": "^11.16.1",
		"morphicons": "^1.4.2",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.12.0",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"happy-dom": "^20.12.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"dist",
		"src",
		"scripts",
		"public",
		"index.html",
		"README.md",
		"CHANGELOG.md"
	]
}