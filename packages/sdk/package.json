{
	"name": "@musepi/sdk",
	"version": "0.3.1",
	"description": "MusePi daemon protocol contract: JSON-RPC method table + TypeBox schemas (single source of truth for GUI/TUI/remote clients).",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./methods/*": {
			"types": "./src/methods/*.ts",
			"import": "./src/methods/*.ts"
		}
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.0",
		"@musepi/pi-wire": "17.3.4"
	}
}
