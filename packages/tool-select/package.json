{
	"type": "module",
	"name": "@musepi/pi-tool-select",
	"version": "0.4.9",
	"description": "Progressive tool disclosure (select_tools) \u2014 keep MCP schemas out of top-level tools[], load on demand",
	"license": "MIT",
	"author": "MuseLinn",
	"contributors": [
		"Mario Zechner",
		"Can Boluk"
	],
	"keywords": [
		"tool-select",
		"progressive-disclosure",
		"mcp"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "biome check .",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test --parallel",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	}
}