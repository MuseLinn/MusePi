{
	"modelVersion": "6.0.0",
	"dependencies": {},
	"execution": {},
	"logging": {},
	"debugging": {},
	// The shell packages a ~32 MB web bundle into rawfile; the default daemon
	// heap is not enough for resource packing and fails with
	// "00306056 Specification Limit Violation".
	"nodeOptions": {
		"maxOldSpaceSize": 8192
	}
}
