<?xml version="1.0" encoding="utf-8"?>
<!--
  MusePi installer host — application manifest.

  DPI awareness is the reason this file exists. Without it the process is
  DPI-unaware, so on a scaled display (125% / 150%) Windows renders the window
  at 96 DPI and then BITMAP-STRETCHES the whole thing to the physical size —
  text and the WebView2 surface come out visibly blurry. Declaring per-monitor
  v2 makes the host render at native resolution and lets WebView2 lay out at the
  real device pixel ratio.

  order matters to Windows: dpiAwareness (Win10 1703+) is preferred, and
  dpiAware (Vista+) is the fallback for older systems. Both are declared.

  RequestedExecutionLevel stays asInvoker: the installer runs per-user and must
  never trigger a UAC prompt on launch.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      version="1.0.0.0"
      processorArchitecture="*"
      name="MusePi.Installer.Host"
      type="win32" />
  <description>MusePi Installer Host</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compat.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <!-- Draw the client area in dark mode so the WebView2 surface does not
           flash white before the page paints. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
