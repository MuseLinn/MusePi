{
	"extends": "../tsconfig.workspace.json",
	"include": [
		"src",
		"scripts"
	],
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true,
		"types": [
			"bun",
			"react",
			"react-dom",
			"assets"
		],
		"paths": {
			"@musepi/client-core/src/*": [
				"./../client-core/src/*"
			]
		}
	}
}
