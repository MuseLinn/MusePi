<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <!-- MusePi pi silhouette on the 64-grid brand geometry (see
         scripts/regen-brand-icons.py FAV_PATH_64): bar 36x8, left leg flush
         14..22, right leg inset 34..42 with the 8-unit right overhang, total
         36x44. Mapped 1:1 into the 108dp viewport (translated to
         (36,32)-(72,76)) so the vector, the PNG layers and the favicons share
         one geometry. Fill and stroke share the anchor's off-white; the round
         join gives the dot-soft corners. Stroke-incl. bbox ~39x47 stays inside
         the 66dp adaptive-icon safe zone. Also used as the monochrome layer
         (themed icons read its alpha and tint it). -->
    <path
        android:fillColor="#ECE8E9"
        android:pathData="M36,32h36v8h-8v36h-8V40h-12v36h-8V32z"
        android:strokeColor="#ECE8E9"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />
</vector>
